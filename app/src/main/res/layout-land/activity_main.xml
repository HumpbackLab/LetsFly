<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

    <!-- Left Joystick - positioned in bottom-left quadrant for easy thumb access -->
    <com.example.myapplication.Joystick
            android:id="@+id/leftJoystick"
            android:layout_width="@dimen/joystick_width"
            android:layout_height="@dimen/joystick_height"
            app:defaultXPercent="0"
            app:defaultYPercent="-1"
            app:yReturnDefault="false"
            app:showText="false"
            android:layout_margin="@dimen/spacing_m"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintVertical_bias="0.9"
            app:joystickBackgroundColor="@color/joystick_background"
            app:joystickInnerCircleColor="@color/joystick_inner_circle"
            app:joystickButtonColor="@color/joystick_button"/>

    <!-- Right Joystick - positioned in bottom-right quadrant for easy thumb access -->
    <com.example.myapplication.Joystick
            android:id="@+id/rightJoystick"
            android:layout_width="@dimen/joystick_width"
            android:layout_height="@dimen/joystick_height"
            app:showText="false"
            android:layout_margin="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.75"
            app:layout_constraintVertical_bias="0.9"
            app:joystickBackgroundColor="@color/joystick_background"
            app:joystickInnerCircleColor="@color/joystick_inner_circle"
            app:joystickButtonColor="@color/joystick_button"/>

    <!-- Top Controls Container -->
    <LinearLayout
            android:id="@+id/topControlsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <!-- Left Group: Connection Button Only -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

            <!-- Connect Button -->
            <Button
                    android:id="@+id/openSerialButton"
                    android:layout_width="@dimen/button_width"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:onClick="openSerial"
                    android:text="@string/btn_connect"/>

        </LinearLayout>

        <!-- Right Group: Settings and Switches -->
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <!-- Settings Button -->
            <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="@dimen/button_width"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:onClick="openSettings"
                    android:text="@string/btn_settings"/>

            <!-- Arm Switch -->
            <Switch
                    android:id="@+id/switchArm"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="@string/btn_arm"/>

            <!-- CH6 Three-Position Switch -->
            <Button
                    android:id="@+id/switchCH6"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="@string/btn_ch6"/>

            <!-- CH7 Three-Position Switch -->
            <Button
                    android:id="@+id/switchCH7"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="@string/btn_ch7"/>

            <!-- CH8 Three-Position Switch -->
            <Button
                    android:id="@+id/switchCH8"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="@string/btn_ch8"/>

        </LinearLayout>
    </LinearLayout>

    <!-- TextView for debug information - positioned below controls -->
    <TextView
            android:id="@+id/testView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_s"
            android:keepScreenOn="true"
            android:text=""
            android:maxLines="10"
            android:scrollbars="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topControlsContainer"/>

</androidx.constraintlayout.widget.ConstraintLayout>